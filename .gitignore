# Dependencies
node_modules/

# Scratch folders created by the runner scripts (npm run solution, verification)
.solution-check/
.verify/
.check-*/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/

# Build output and caches
dist/
build/
.cache/
.eslintcache
*.tsbuildinfo

# Package manager leftovers (keep package-lock.json committed)
.npm/
.yarn/
.pnpm-store/

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini